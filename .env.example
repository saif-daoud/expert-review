# Replace both values before inviting experts.
STUDY_ACCESS_CODE=replace-with-a-new-access-code
STUDY_TOKEN_SECRET=replace-with-a-long-random-value

# Participant codes and their non-overlapping profile assignments.
STUDY_EXPERT_1_CODE=EXPERT-5834
STUDY_EXPERT_2_CODE=EXPERT-9271
STUDY_EXPERT_1_PROFILE_IDS=patient_act_001,patient_act_002,patient_act_003,patient_act_021,patient_act_022,patient_act_005,patient_act_008,patient_act_010,patient_act_012,patient_act_014,patient_act_017,patient_act_019,patient_act_024,patient_act_027,patient_act_029,patient_act_031,patient_act_033,patient_act_035,patient_act_037,patient_act_039
STUDY_EXPERT_2_PROFILE_IDS=patient_act_004,patient_act_007,patient_act_016,patient_act_023,patient_act_026,patient_act_006,patient_act_009,patient_act_011,patient_act_013,patient_act_015,patient_act_018,patient_act_020,patient_act_025,patient_act_028,patient_act_030,patient_act_032,patient_act_034,patient_act_036,patient_act_038,patient_act_040

# Public website origins only; do not include a path or trailing slash.
STUDY_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://saif-daoud.github.io
STUDY_SERVE_FRONTEND=false

STUDY_INFERENCE_MODE=real
STUDY_MAX_SESSION_TURNS=50

# External model artifacts. No Python code is imported from these directories.
STUDY_ARCHER_CHECKPOINT=/home/local/QCRI/saif.sedaoud/clean-env/baselines/outputs/cbt_offlinearcher_qwen25_7b/csv_logs/version_0/checkpoints/epoch=9-step=13294.ckpt
STUDY_ARIA_CHECKPOINT=/home/local/QCRI/saif.sedaoud/clean-env/baselines/outputs/cbt_aria_qwen25_7b/checkpoints/trainer.pt
STUDY_SWEET_RL_MODEL=/home/local/QCRI/saif.sedaoud/clean-env/baselines/runs/sweet_rl_cbt_qwen25_7b_full/checkpoints/actor_no_tti

# Real TOPAS configuration. The Python runtime and action-space JSON are
# bundled in server/; only these trained artifacts stay external.
STUDY_TOPAS_VARIANT=iql_policy_term_intra_with_conv
STUDY_TOPAS_RUNS_DIR="/home/local/QCRI/saif.sedaoud/clean-env/new_env/TOPA/outputs/cognitive behavioral therapy/rl/runs"
STUDY_TOPAS_CONV_STATE_DIR="/home/local/QCRI/saif.sedaoud/clean-env/new_env/TOPA/outputs/cognitive behavioral therapy/rl/runs/sft_conv_state_acts_L22"
SIMULATION_MACRO_POLICY_DIR=none
SIMULATION_MICRO_POLICY_DIR=none
SIMULATION_FILTER_MACROS_BY_TERMINATION=false
SIMULATION_MACRO_POLICY_DETERMINISTIC=false
SIMULATION_TERMINATION_DETERMINISTIC=false
SIMULATION_MICRO_POLICY_DETERMINISTIC=false
SIMULATION_TERMINATION_THRESHOLD=0.5
SIMULATION_POLICY_CONV_STATE_ONLY=true
SIMULATION_CONTEXT_TURNS=5
SIMULATION_CONV_STATE_UPDATE_INTERVAL=1
SIMULATION_MAX_MACRO_TURNS=-1
SIMULATION_DEVICE=cuda

# Conda environments used by session-scoped model workers.
STUDY_CONDA_ENV_BASE=base
STUDY_CONDA_ENV_ARCHER=archer_env
STUDY_CONDA_ENV_ARIA=aria_env
STUDY_CONDA_ENV_SWEET_RL=sweet_rl

# Two free A6000s in the supplied server snapshot. Each worker sees its
# assigned physical GPU as cuda:0 inside its process.
STUDY_GPU_BASE=0
STUDY_GPU_ARCHER=0
STUDY_GPU_ARIA=3
STUDY_GPU_SWEET_RL=3

# Optional absolute path if `conda` is not inherited by the API process.
